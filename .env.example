# Public browser configuration; use a Supabase publishable or anon key, never a service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Enable only after reviewing Google's terms and configuring an appropriate paid project.
AI_ENABLED=false
USDA_API_KEY=
# Required for the Open Food Facts identification header; replace with your contact email.
FOOD_API_CONTACT=
